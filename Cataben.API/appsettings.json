{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Database=cataben;Username=cataben;Password=cataben123",
    "Redis": "redis:6379"
  },

  "Clerk": {
    "ApiKey": "your_clerk_api_key",
    "Issuer": "https://your-clerk-domain.com",
    "WebhookSecret": "your_webhook_secret"
  },

  "Nats": {
    "Url": "nats://cataben:cataben_nats_dev@nats:4222",
    "MaxReconnects": 10,
    "ReconnectWaitMs": 1000,
    "ResultSigningKey": "dev_result_signing_key_change_me"
  },

  "Sandbox": {
    "Image": "cataben-sandbox:latest",
    "MaxMemoryMb": 256,
    "MaxCpuPercent": 50,
    "MaxConcurrentSandboxes": 10,
    "DefaultTimeoutSeconds": 10
  },

  "OpenTelemetry": {
    "Endpoint": "http://otel-collector:4318"
  },

  "AllowedHosts": "*"
}
