{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Nats": {
    "Url": "nats://cataben:cataben_nats_dev@nats:4222",
    "MaxReconnects": 10,
    "ReconnectWaitMs": 1000,
    "RequestTimeoutSeconds": 30,
    "ResultSigningKey": "dev_result_signing_key_change_me"
  },
  "Worker": {
    "MaxConcurrentTasks": 10,
    "DefaultTimeoutSeconds": 30,
    "MemoryLimitMb": 512,
    "CpuLimitPercent": 50,
    "EnableResourceMonitoring": true
  },
  "Sandbox": {
    "Image": "cataben-sandbox:latest",
    "MaxMemoryMb": 256,
    "MaxCpuPercent": 50,
    "DefaultTimeoutSeconds": 10,
    "NetworkName": "cataben-sandbox-network",
    "UseDocker": true
  },
  "Ai": {
    "Provider": "deepseek",
    "ApiKey": "",
    "BaseUri": "https://api.deepseek.com",
    "Model": "deepseek-v4-flash",
    "Temperature": 0.0,
    "TimeoutSeconds": 15
  },
  "OpenTelemetry": {
    "Endpoint": "http://otel-collector:4318"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
